# ─── Environment ──────────────────────────────────────────────────────────────
# Controls which Angular build is used for both frontends.
# Use "production" for mainnet deployments, "testnet" for testnet deployments.
# See .env.example.test for the testnet variant of this file.
FRONTEND_BUILD_ENV=production
# Enables fail-fast production safety checks in the backend. Leave false for the local demo;
# set true for a real deployment only after replacing every development-only adapter/secret.
REGISTERWERK_PRODUCTION_MODE=true

# ─── Documentation Server ─────────────────────────────────────────────────────
# Compose's profile bridge for CHAINCACHE_ENABLED. Keep chaincache-true in this list; add `docs`
# (comma-separated) when the documentation server should also start.
COMPOSE_PROFILES=chaincache-true
# Documentation is served on http://<host>:48003 when the docs profile is active.
# Base URL of the backend — used in doc links (Swagger UI, actuator, etc.). Set it to the
# server-visible address (for example http://nibbler.local:48080) when building docs remotely.
BACKEND_URL=http://localhost:48080
# Bind address for the docs server. Defaults to 0.0.0.0 (all interfaces).
# Set to 127.0.0.1 to restrict to loopback (access via SSH tunnel only).
# DOCS_BIND_ADDR=127.0.0.1
# Bind address for the backend API (host port 48080). Defaults to 127.0.0.1 (loopback).
# Set to 0.0.0.0 on remote dev/staging hosts to allow direct access to Swagger UI.
# In production the backend is reached via Kong — keep this on loopback.
# BACKEND_BIND_ADDR=0.0.0.0
# Enables /api-docs and /swagger-ui.html on the backend. Off by default.
# Must be true for the doc server links to OpenAPI/Swagger to work.
SWAGGER_ENABLED=false

# ─── Application Database ─────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/registerwerk
DB_USER=registerwerk
DB_PASSWORD=changeme
POSTGRES_HOST_PORT=45432
BACKEND_HOST_PORT=48080

# ─── Kong Gateway ─────────────────────────────────────────────────────────────
# Kong runs DB-less (declarative config in gateway/kong.yml) — no credentials needed.
# Admin API is bound to the host's loopback only.
KONG_PROXY_HOST_PORT=48000
KONG_ADMIN_HOST_PORT=48001
KONG_HTTPS_HOST_PORT=48443

# ─── Default admin (used when ENTRA_ENABLED=false) ────────────────────────────
# Set these to enable built-in username/password login for the operator frontend.
# The password is BCrypt-hashed on startup and refreshed whenever the app restarts.
# Not for production — use an IdP (see below) for production deployments.
ENTRA_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=changeme-please
JWT_DEV_SECRET=registerwerk-dev-jwt-secret-change-in-production!!   # change in staging/prod
SEED_DEMO_DATA=false
# Host/browser port for the disposable Anvil node. Compose services always use anvil:8545;
# changing this value must not change container-to-container RPC URLs.
ANVIL_BIND_ADDR=127.0.0.1
ANVIL_HOST_PORT=48545
ANVIL_PUBLIC_RPC_URL=http://localhost:48545

# ─── chaincache (the showcase) ─────────────────────────────────────────────────
# Set true to start both Chaincache workloads plus their private Postgres service on
# the next ordinary `docker compose up -d`. Set false to leave them out of the deployment.
CHAINCACHE_ENABLED=false
# Registerwerk never builds ../chaincache. Load, pull or build this image independently and put
# its exact tag here. `missing` uses a local image first and pulls only when it is absent.
CHAINCACHE_IMAGE=registerwerk-chaincache:latest
CHAINCACHE_PULL_POLICY=missing
CHAINCACHE_SEPOLIA_HOST_PORT=48090
CHAINCACHE_BASE_HOST_PORT=48091
# Shared between Registerwerk and every chaincache workload it talks to — chaincache's own
# default posture is chaincache.auth.enabled: true, so without a matching secret every
# GET /api/capabilities probe 401s and every chaincache node silently demotes to DIRECT_RPC.
# Change in staging/prod; must be at least 32 characters (HS256 key-length requirement).
CHAINCACHE_JWT_SECRET=registerwerk-chaincache-demo-secret-change-me

# ─── Transaction-signing HSM (one PKCS#11 token per instance) ────────────────
# The Compose demo enables SoftHSM automatically. Production must replace the provider config,
# PKCS#11 library and PIN with the settings for the installed Thales Luna or Utimaco client.
# Valid profiles: SOFTHSM, THALES, UTIMACO, CUSTOM.
REGISTERWERK_HSM_ENABLED=true
REGISTERWERK_HSM_PROFILE=SOFTHSM
REGISTERWERK_HSM_PROVIDER_CONFIG=/etc/registerwerk/pkcs11.cfg
REGISTERWERK_HSM_PIN=123456
# Only needed for CUSTOM devices whose raw secp256k1 mechanism is exposed under another JCA name.
REGISTERWERK_HSM_SIGNATURE_ALGORITHM=
# Demo token initialization only; never reuse these values or the bundled Anvil key elsewhere.
DEMO_HSM_SO_PIN=12345678
DEMO_HSM_USER_PIN=123456

# ─── OAuth2 / JWT ─────────────────────────────────────────────────────────────
# Leave JWT_ISSUER_URI blank to use built-in HS256 dev mode (ENTRA_ENABLED=false).
# Set it to your IdP's issuer URL and flip ENTRA_ENABLED=true for production.
#
# Note both are needed and they do different things: ENTRA_ENABLED decides how users sign in,
# JWT_ISSUER_URI decides how their tokens are validated. The backend accepts locally minted
# HS256 tokens either way, so the operator portal keeps working with built-in login and local
# TOTP step-up even when customers sign in through Entra.
JWT_ISSUER_URI=
# Expected `aud` of Entra access tokens — the API app registration's client id or Application
# ID URI. Without it, a token Entra issued for ANY other app in the same tenant is accepted
# here. Required by ProductionReadinessCheck once ENTRA_ENABLED=true.
JWT_AUDIENCE=

# ─── Microsoft Entra ID ───────────────────────────────────────────────────────
# Two app registrations: the API (this backend) and the SPA (frontend-customer).
# Setup runbook: docs/platform/entra-setup.md
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<api-client-id>                 # API app registration — also the JWT audience
ENTRA_CLIENT_SECRET=<api-client-secret>         # app-only credential for Microsoft Graph
ENTRA_SPA_CLIENT_ID=<spa-client-id>             # served to the browser by /public/auth/config
ENTRA_API_SCOPE=api://<api-client-id>/access_as_user

# Master switch for every Microsoft Graph call — the customer 2FA status page and the operator
# support console (method reset, session revocation, Temporary Access Pass). Independent of
# ENTRA_ENABLED: sign-in can run without Graph, it just loses those two features.
# Requires Graph application permissions UserAuthenticationMethod.ReadWrite.All and
# User.RevokeSessions.All, plus the Authentication Administrator directory role on the
# service principal.
ENTRA_SUPPORT_ENABLED=false
ENTRA_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Conditional Access authentication context (c1–c99) required for step-up-protected actions
# when ENTRA_ENABLED=true. Must exist in the tenant AND be published to apps — an unpublished
# context can never be satisfied and produces a sign-in redirect loop. Validated at startup.
ENTRA_STEPUP_AUTH_CONTEXT_ID=
ENTRA_AUTHORIZATION_URI=https://login.microsoftonline.com/common/oauth2/authorize

# Where customers are sent to register a second factor. Microsoft owns this page: Graph offers
# no way to create an Authenticator or TOTP method, so Registerwerk can only link users there.
ENTRA_MFA_SETUP_URL=https://mysignins.microsoft.com/security-info
# Opt-in hard gate redirecting customers to /security until a factor is registered. Off by
# default — Conditional Access already blocks unenrolled users at sign-in, and gating on a
# Graph read would turn a Graph outage into a full portal outage.
ENTRA_REQUIRE_2FA_ENROLMENT=false

# ─── Blockchain RPC Endpoints — Production (all mainnets) ────────────────────
ETH_MAINNET_RPC=https://mainnet.infura.io/v3/<key>
ETH_SEPOLIA_RPC=<not-used-in-prod>
POLYGON_MAINNET_RPC=https://polygon-mainnet.infura.io/v3/<key>
POLYGON_AMOY_RPC=<not-used-in-prod>
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=<not-used-in-prod>
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC=<not-used-in-prod>
ARBITRUM_MAINNET_RPC=https://arbitrum.publicnode.com
ARBITRUM_SEPOLIA_RPC=<not-used-in-prod>
AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_FUJI_RPC=<not-used-in-prod>
OPTIMISM_MAINNET_RPC=https://mainnet.optimism.io
OPTIMISM_SEPOLIA_RPC=<not-used-in-prod>

# ─── EVM subgraph static sources ──────────────────────────────────────────────
# deploy-subgraph.sh selects a suffix per target (MAINNET, SEPOLIA, POLYGON,
# POLYGON_AMOY, BASE, BASE_SEPOLIA, ARBITRUM, ARBITRUM_SEPOLIA, AVALANCHE,
# AVALANCHE_FUJI, OPTIMISM or OPTIMISM_SEPOLIA). Configure all sources for every target used.
# Start blocks should be the actual contract deployment blocks; zero is accepted only for a
# deliberate full-chain replay. See docs/operator/indexers/the-graph.md.
# ASSET_TOKEN_FACTORY_ADDRESS_MAINNET=0x...
# ASSET_TOKEN_FACTORY_START_BLOCK_MAINNET=0
# REPO_MARKET_FACTORY_ADDRESS_MAINNET=0x...
# REPO_MARKET_FACTORY_START_BLOCK_MAINNET=0
# DVP_SETTLEMENT_ADDRESS_MAINNET=0x...
# DVP_SETTLEMENT_START_BLOCK_MAINNET=0
# CONFIDENTIAL_FACTORY_ADDRESS_MAINNET=0x...
# CONFIDENTIAL_FACTORY_START_BLOCK_MAINNET=0
# Multi-instance sources require comma-separated address@deploymentBlock entries. Use exactly
# NONE to declare an intentionally absent role; unset/empty values fail closed.
# BOND_DESK_INSTANCES_MAINNET=0x...@123456,0x...@234567
# STABLECOIN_AMM_INSTANCES_MAINNET=NONE
# REPO_VAULT_INSTANCES_MAINNET=0x...@123456

# ─── Canton — Operator-run participant (Ledger API gRPC) ─────────────────────
# Point these to your participant's Ledger API endpoint (host:port, no scheme).
# For the public Canton Network: register at https://canton.network and supply
#   the Ledger API URL from your participant dashboard.
# For local development: run `docker compose -f indexer/canton/docker-compose.yml up`
#   and use the defaults below.
CANTON_MAINNET_LEDGER_URL=                              # e.g. grpcs://participant.example.com:5001 (TLS)
CANTON_MAINNET_SYNCHRONIZER=global-synchronizer        # Canton Network global synchronizer alias
CANTON_MAINNET_TOKEN=                                   # JWT for participant auth (leave blank if mTLS)
CANTON_DEVNET_LEDGER_URL=grpc://localhost:5001          # explicit plaintext local sidecar
CANTON_DEVNET_SYNCHRONIZER=dev-synchronizer            # local sidecar domain alias
CANTON_DEVNET_TOKEN=                                    # JWT for devnet participant
CANTON_APPLICATION_ID=registerwerk

# ─── Registry Wallet (backend signer) ────────────────────────────────────────
# Master key used to encrypt wallet keystores stored in the docker volume.
# Must be ≥ 32 characters. Generate a secure value with: openssl rand -base64 32
# REMOVED: REGISTRY_WALLET_PRIVATE_KEY — import keys via the Operator Portal → Wallets.
REGISTERWERK_WALLET_MASTER_KEY=<generate-with: openssl rand -base64 32>

# ─── Object Storage (S3-compatible, for documents ≥ 5 MB) ────────────────────
S3_BUCKET=registerwerk-documents
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_REGION=eu-central-1

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=changeme

# ─── Travel Rule transport ───────────────────────────────────────────────────
# NOOP is for local/demo use only and is rejected when REGISTERWERK_PRODUCTION_MODE=true.
# Choose NOTABENE or TRP in production.
REGISTERWERK_TRAVEL_RULE_PROTOCOL=NOOP
REGISTERWERK_TRAVEL_RULE_NOTABENE_BASE_URL=https://api.notabene.id
REGISTERWERK_TRAVEL_RULE_NOTABENE_API_KEY=
REGISTERWERK_TRAVEL_RULE_NOTABENE_VASP_DID=
REGISTERWERK_TRAVEL_RULE_TRP_ENDPOINT=
REGISTERWERK_TRAVEL_RULE_TRP_DIRECTORY_URL=https://trp.notabene.id/directory
# TRP uses an X.509 PEM certificate and an unencrypted PKCS#8 PEM private key.
REGISTERWERK_TRAVEL_RULE_TRP_MTLS_CERT=
REGISTERWERK_TRAVEL_RULE_TRP_MTLS_KEY=

# Required by POST /api/v1/public/travel-rule/inbox. Generate a separate high-entropy secret;
# leaving it blank disables the inbox. Counterparties send it as X-Travel-Rule-Api-Key.
REGISTERWERK_TRAVEL_RULE_INBOX_API_KEY=<generate-with: openssl rand -base64 32>

# ─── Frontends ────────────────────────────────────────────────────────────────
# Set these to the externally visible frontend URLs when deploying remotely, for example:
# OPERATOR_FRONTEND_URL=http://nibbler.local:44200
# CUSTOMER_FRONTEND_URL=http://nibbler.local:44201
# Compose derives the backend CORS allow-list from these two values. Set this explicitly only
# when API callers use additional, separate origins (comma-separated).
# REGISTERWERK_CORS_ALLOWED_ORIGINS=http://nibbler.local:44200,http://nibbler.local:44201
CUSTOMER_FRONTEND_URL=http://localhost:44201
OPERATOR_FRONTEND_URL=http://localhost:44200
OPERATOR_FRONTEND_HOST_PORT=44200
CUSTOMER_FRONTEND_HOST_PORT=44201
DOCS_HOST_PORT=48003

# ─── Optional monitoring stack host ports ────────────────────────────────────
PROMETHEUS_HOST_PORT=49090
GRAFANA_HOST_PORT=43000
LOKI_HOST_PORT=43100
OTLP_GRPC_HOST_PORT=44317
OTLP_HTTP_HOST_PORT=44318
PUSHGATEWAY_HOST_PORT=49091
ALERTMANAGER_HOST_PORT=49093
POSTGRES_EXPORTER_HOST_PORT=49187
NODE_EXPORTER_HOST_PORT=49100

# ─── Confidential tokens (Zama fhEVM) ─────────────────────────────────────────
# zama-relayer is Registerwerk's own sidecar wrapping @zama-fhe/relayer-sdk (Zama publishes no
# Java/JVM client). Enable it with: docker compose --profile confidential up
# Only needed for operator/issuer-initiated confidential mint/force-burn and headless
# operator/auditor balance reconciliation — investor/issuer self-decrypt and confidential
# transfers happen entirely client-side in the frontends, never through this sidecar or backend.
ZAMA_CONFIG_PRESET=sepolia
ZAMA_RELAYER_HOST_PORT=43005
ZAMA_CHAIN_ID=11155111
# Only used when ZAMA_CONFIG_PRESET=custom (e.g. once Ethereum/Base mainnet or T-REX Chain
# publish their own FHEVM addresses — see docs/blockchains/confidential-evm.md):
ZAMA_NETWORK_RPC_URL=
ZAMA_RELAYER_UPSTREAM_URL=
ZAMA_GATEWAY_CHAIN_ID=
ZAMA_ACL_CONTRACT_ADDRESS=
ZAMA_KMS_CONTRACT_ADDRESS=
ZAMA_INPUT_VERIFIER_CONTRACT_ADDRESS=
ZAMA_VERIFYING_CONTRACT_ADDRESS_DECRYPTION=
ZAMA_VERIFYING_CONTRACT_ADDRESS_INPUT_VERIFICATION=
# Dedicated decrypt-only keypair for the registry operator/auditor viewer role — generate with
# `openssl rand -hex 32` and prefix with 0x. Deliberately NOT a chain's on-chain
# transaction-signing wallet (those are configured via Operator Portal → Wallets): a compromised
# relayer sidecar can then decrypt confidential balances it's a registered viewer on, but cannot
# move funds or submit transactions. Its public address must be passed as one of the confidential
# token's initialViewers at deploy (or added later via addViewer).
#
# : PREFER the envelope-encrypted pair over the plaintext var above — the
# plaintext key sits unencrypted in the container environment for the process lifetime, whereas
# the wrapped key is only unwrapped in-memory at boot (same AES-256-GCM KEK/DEK scheme as the
# backend's wallet module). Produce the wrapped value once, offline:
#   cd zama-relayer && RELAYER_KEK_MASTER_KEY=<master-key> npm run wrap-operator-key -- <rawKeyHex>
# then set ZAMA_OPERATOR_DECRYPT_PRIVATE_KEY_WRAPPED to its output and ZAMA_RELAYER_KEK_MASTER_KEY
# to the same master key, and leave ZAMA_OPERATOR_DECRYPT_PRIVATE_KEY above blank. The plaintext
# var still works (with a startup warning) when neither of these is set, for local/dev convenience.
ZAMA_OPERATOR_DECRYPT_PRIVATE_KEY=
ZAMA_OPERATOR_DECRYPT_PRIVATE_KEY_WRAPPED=
ZAMA_RELAYER_KEK_MASTER_KEY=
# Shared secret every /v1/* request to the sidecar must present  — without
# it, any process reachable on the compose network could call the sidecar's operator-decrypt
# route directly and decrypt any confidential balance, bypassing the backend's own RBAC entirely.
# Same "must never be empty" treatment as JWT_DEV_SECRET below — change this in production.
# Generate with: openssl rand -hex 32
ZAMA_RELAYER_API_KEY=registerwerk-dev-zama-relayer-key-change-in-production
# Read by the backend (registerwerk.zama.relayer-url) — leave as the in-compose default unless
# running the sidecar elsewhere.
REGISTERWERK_ZAMA_RELAYER_URL=http://zama-relayer:3001

# ─── Monitoring (monitoring/docker-compose.yml) ───────────────────────────────
# Previously this had no entry here at all — unlike every other credential in this file, an
# operator following docs/operator/maintenance/monitoring.md's literal instructions would get
# a real, guessable default . Grafana's own port binding is loopback-
# only by default, but change this regardless before exposing it beyond localhost.
GRAFANA_ADMIN_PASSWORD=changeme
