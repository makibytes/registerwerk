# ─── Environment ──────────────────────────────────────────────────────────────
# Controls which Angular build is used for both frontends.
# Use "production" for mainnet deployments, "testnet" for testnet deployments.
# See .env.example.test for the testnet variant of this file.
FRONTEND_BUILD_ENV=production

# ─── Documentation Server ─────────────────────────────────────────────────────
# Uncomment to start the MkDocs documentation server on http://<host>:8003.
# COMPOSE_PROFILES=docs
# Base URL of the backend — used in doc links (Swagger UI, actuator, etc.).
BACKEND_URL=http://localhost:8080
# Bind address for the docs server. Defaults to 0.0.0.0 (all interfaces).
# Set to 127.0.0.1 to restrict to loopback (access via SSH tunnel only).
# DOCS_BIND_ADDR=127.0.0.1
# Bind address for the backend API (port 8080). Defaults to 127.0.0.1 (loopback).
# Set to 0.0.0.0 on remote dev/staging hosts to allow direct access to Swagger UI.
# In production the backend is reached via Kong — keep this on loopback.
# BACKEND_BIND_ADDR=0.0.0.0
# Enables /api-docs and /swagger-ui.html on the backend. Off by default.
# Must be true for the doc server links to OpenAPI/Swagger to work.
SWAGGER_ENABLED=false

# ─── Application Database ─────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/registerwerk
DB_USER=registerwerk
DB_PASSWORD=changeme

# ─── Kong Database ────────────────────────────────────────────────────────────
KONG_DB_USER=kong
KONG_DB_PASSWORD=changeme
# Kong Manager UI is built into Kong 3.x — access via http://localhost:8002
# In production, keep 8002 localhost-bound and access via SSH tunnel.

# ─── Default admin (used when ENTRA_ENABLED=false) ────────────────────────────
# Set these to enable built-in username/password login for the operator frontend.
# The password is BCrypt-hashed on startup and refreshed whenever the app restarts.
# Not for production — use an IdP (see below) for production deployments.
ENTRA_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=changeme-please
JWT_DEV_SECRET=registerwerk-dev-jwt-secret-change-in-production!!   # change in staging/prod
SEED_DEMO_DATA=false

# ─── OAuth2 / JWT ─────────────────────────────────────────────────────────────
# Leave JWT_ISSUER_URI blank to use built-in HS256 dev mode (ENTRA_ENABLED=false).
# Set it to your IdP's issuer URL and flip ENTRA_ENABLED=true for production.
JWT_ISSUER_URI=
ENTRA_CLIENT_ID=<client-id>
ENTRA_CLIENT_SECRET=<client-secret>
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ─── Blockchain RPC Endpoints — Production (all mainnets) ────────────────────
ETH_MAINNET_RPC=https://mainnet.infura.io/v3/<key>
ETH_SEPOLIA_RPC=<not-used-in-prod>
POLYGON_MAINNET_RPC=https://polygon-mainnet.infura.io/v3/<key>
POLYGON_AMOY_RPC=<not-used-in-prod>
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=<not-used-in-prod>
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC=<not-used-in-prod>
ARBITRUM_MAINNET_RPC=https://arbitrum.publicnode.com
ARBITRUM_SEPOLIA_RPC=<not-used-in-prod>
AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_FUJI_RPC=<not-used-in-prod>
OPTIMISM_MAINNET_RPC=https://mainnet.optimism.io
OPTIMISM_SEPOLIA_RPC=<not-used-in-prod>

# ─── Canton — Operator-run participant (Ledger API gRPC) ─────────────────────
# Point these to your participant's Ledger API endpoint (host:port, no scheme).
# For the public Canton Network: register at https://canton.network and supply
#   the Ledger API URL from your participant dashboard.
# For local development: run `docker compose -f indexer/canton/docker-compose.yml up`
#   and use the defaults below.
CANTON_MAINNET_LEDGER_URL=                              # e.g. participant.example.com:5001
CANTON_MAINNET_SYNCHRONIZER=global-synchronizer        # Canton Network global synchronizer alias
CANTON_MAINNET_TOKEN=                                   # JWT for participant auth (leave blank if mTLS)
CANTON_DEVNET_LEDGER_URL=localhost:5001                 # local sidecar default
CANTON_DEVNET_SYNCHRONIZER=dev-synchronizer            # local sidecar domain alias
CANTON_DEVNET_TOKEN=                                    # JWT for devnet participant
CANTON_APPLICATION_ID=registerwerk

# ─── Registry Wallet (backend signer) ────────────────────────────────────────
# Master key used to encrypt wallet keystores stored in the docker volume.
# Must be ≥ 32 characters. Generate a secure value with: openssl rand -base64 32
# REMOVED: REGISTRY_WALLET_PRIVATE_KEY — import keys via the Operator Portal → Wallets.
REGISTERWERK_WALLET_MASTER_KEY=<generate-with: openssl rand -base64 32>

# ─── Object Storage (S3-compatible, for documents ≥ 5 MB) ────────────────────
S3_BUCKET=registerwerk-documents
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_REGION=eu-central-1

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=changeme

# ─── Frontends ────────────────────────────────────────────────────────────────
CUSTOMER_FRONTEND_URL=http://localhost:4201
OPERATOR_FRONTEND_URL=http://localhost:4200
