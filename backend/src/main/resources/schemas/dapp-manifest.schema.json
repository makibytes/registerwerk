{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registerwerk.de/schemas/dapp-manifest.schema.json",
  "title": "Registerwerk dApp Manifest",
  "description": "Metadata-only description of a marketplace dApp: contracts built on the Registerwerk permission framework plus self-hostable containers pinned by OCI digest. The keccak256 hash of the manifest's raw bytes is anchored onchain on approval.",
  "type": "object",
  "required": ["slug", "name", "version", "description", "images", "contact"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
      "description": "Marketplace-unique identifier; onchain dappId = keccak256(slug)"
    },
    "name": { "type": "string", "minLength": 3, "maxLength": 200 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of this manifest"
    },
    "description": { "type": "string", "minLength": 10, "maxLength": 5000 },
    "category": { "type": "string", "maxLength": 60 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "abiSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the contract's ABI JSON"
          },
          "sourceUrl": { "type": "string", "format": "uri" },
          "addresses": {
            "type": "object",
            "description": "Deployed instances per chain identifier (e.g. ethereum-testnet)",
            "additionalProperties": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
          }
        }
      }
    },
    "requiredPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "rationale"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "description": "Permission code enforced via the PermissionOracle; hashed to bytes32 onchain"
          },
          "rationale": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "requiredClaimTopics": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "ONCHAINID claim topics the dApp checks (1=KYC, 2=AML, 3=Accreditation)"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "ref"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "role": { "enum": ["backend", "frontend", "worker"] },
          "ref": {
            "type": "string",
            "pattern": "^[\\w.\\-/:]+@sha256:[a-f0-9]{64}$",
            "description": "OCI image reference pinned by digest — tag-only references are rejected"
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composeUrl": { "type": "string", "format": "uri" },
        "composeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "helmChartRef": { "type": "string", "maxLength": 300 }
      }
    },
    "paymentMethods": {
      "type": "array",
      "description": "Payment legs the dApp supports for the cash side of its flows. Entries either reference an operator-curated payment rail by code (validated: the rail must exist and be enabled) or declare a custom method the dApp implements itself (surfaced prominently in operator review).",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["rail"],
            "additionalProperties": false,
            "properties": {
              "rail": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
                "description": "Code of an operator-curated payment rail (e.g. aueur, usdc, pontes, erc7573-dvp)"
              },
              "note": { "type": "string", "maxLength": 500 }
            }
          },
          {
            "type": "object",
            "required": ["custom"],
            "additionalProperties": false,
            "properties": {
              "custom": {
                "type": "object",
                "required": ["name", "description"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "maxLength": 120 },
                  "description": { "type": "string", "minLength": 10, "maxLength": 500 },
                  "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                }
              },
              "note": { "type": "string", "maxLength": 500 }
            }
          }
        ]
      }
    },
    "docsUrl": { "type": "string", "format": "uri" },
    "contact": { "type": "string", "format": "email" },
    "license": { "type": "string", "maxLength": 120 },
    "pricingNote": { "type": "string", "maxLength": 500 }
  }
}
