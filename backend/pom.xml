<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>de.makibytes</groupId>
  <artifactId>registerwerk</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Registerwerk</name>
  <description>Registerwerk — electronic securities registry by Maki Bytes</description>

  <properties>
    <java.version>25</java.version>
    <spring-modulith.version>2.1.0</spring-modulith.version>
    <web3j.version>4.12.3</web3j.version>
    <solanaj.version>1.28.0</solanaj.version>
    <daml-bindings.version>3.5.3</daml-bindings.version>
    <grpc.version>1.82.0</grpc.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>3.0.3</springdoc.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <jacoco.version>0.8.15</jacoco.version>
    <greenmail.version>2.1.7</greenmail.version>
    <awssdk.version>2.44.14</awssdk.version>
    <shedlock.version>6.9.2</shedlock.version>
    <!-- Narrow security patch overrides until the next Spring Boot BOM release carries them. -->
    <netty.version>4.2.16.Final</netty.version>
    <postgresql.version>42.7.12</postgresql.version>
    <bouncycastle.version>1.84</bouncycastle.version>
    <!--
      Testcontainers requires a sufficiently new Docker API.
      Force a safe floor for test JVMs so host-level API pinning (e.g. 1.32)
      does not break integration tests.
    -->
    <docker.api.test.version>1.54</docker.api.test.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Solanaj and the PDF-signing stack use different Bouncy Castle artifact lines. Keep
           both on the same patched release instead of letting nearest-dependency mediation
           retain older vulnerable providers in the executable jar. -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk15to18</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcutil-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ── Spring Boot ─────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- ── Database ────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Spring Boot 4.0 splits autoconfiguration into dedicated modules -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>

    <!-- ── Cache ───────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- ── dApp manifest validation (marketplace) ──────────────────────────── -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.9</version>
    </dependency>

    <!-- ── Blockchain — EVM ────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.web3j</groupId>
      <artifactId>core</artifactId>
      <version>${web3j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.web3j</groupId>
      <artifactId>contracts</artifactId>
      <version>${web3j.version}</version>
    </dependency>

    <!-- ── Blockchain — Solana ─────────────────────────────────────────────── -->
    <dependency>
      <groupId>com.mmorrell</groupId>
      <artifactId>solanaj</artifactId>
      <version>${solanaj.version}</version>
    </dependency>

    <!-- Canton/DAML bindings and gRPC are in the 'canton' Maven profile (-Pcanton). -->

    <!-- ── Object Storage (S3) ─────────────────────────────────────────────── -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <!-- ── AWS KMS (wallet key envelope encryption — Track B1) ───────────── -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <!-- ── Azure Key Vault (optional — activate via REGISTERWERK_WALLET_KEK_PROVIDER=AZURE_KEY_VAULT) -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-security-keyvault-keys</artifactId>
      <version>4.10.6</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
      <version>1.18.3</version>
      <optional>true</optional>
    </dependency>
    <!-- ── GCP Cloud KMS (optional — activate via REGISTERWERK_WALLET_KEK_PROVIDER=GCP_KMS) ── -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-kms</artifactId>
      <version>2.94.0</version>
      <optional>true</optional>
    </dependency>
    <!-- ── Apache MINA SSHD SFTP (regulatory report filing) ─────────────── -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>2.18.0</version>
    </dependency>

    <!-- ── Mapping ─────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!-- ── API Docs ────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ── Utilities ───────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>

    <!-- ── Spring Modulith ───────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-docs</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ── Quartz Scheduler (coupon/corporate-action cron — Track C2) ───── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-quartz</artifactId>
    </dependency>

    <!-- ── ShedLock (multi-instance safety for @Scheduled jobs) ─────────── -->
    <!-- Serializes every @Scheduled job across concurrent threads AND multiple backend
         instances via a Postgres row lock (V3__shedlock.sql), so on-chain tx pollers,
         indexers, and reporting crons never double-fire under horizontal scale-out. -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>

    <!-- ── PDF generation (position statements — Track C3) ──────────────── -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.7</version>
    </dependency>

    <!-- ── PDF digital signing (CMS/PKCS#7 via PDFBox external-signing API) ──
         Backs shared.DocumentSigningService — real PAdES-B-B signatures on
         Registerauszug/Depotauszug/Steuerbescheinigung/Registereinsicht when a
         signing keystore is configured (registerwerk.docsig.*); previously these
         documents carried a "PAdES-B-LT Signatur vorhanden" footer that was never
         backed by any signing code at all. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!-- ── AOP (for @RequiresStepUp enforcement) ─────────────────────────── -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!-- ── Observability ─────────────────────────────────────────────────── -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>9.0</version>
    </dependency>

    <!-- ── Test ────────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail-junit5</artifactId>
      <version>${greenmail.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <!-- Digital Asset JFrog — hosts com.daml:bindings-java and related Canton artifacts -->
    <repository>
      <id>digitalasset-releases</id>
      <url>https://digitalasset.jfrog.io/artifactory/libs-release/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <plugins>
      <!-- ── Spring Boot Maven Plugin ────────────────────────────────────── -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- ── MapStruct annotation processor ──────────────────────────────── -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
          <!-- Canton/DAML sources require the authenticated JFrog repository.
               Activate the 'canton' profile (-Pcanton) to compile them. -->
          <excludes>
            <exclude>**/CantonLedgerClient.java</exclude>
            <exclude>**/CantonClientFactory.java</exclude>
            <exclude>**/CantonTokenService.java</exclude>
            <exclude>**/CantonBondService.java</exclude>
            <exclude>**/CantonPartyAllocator.java</exclude>
            <exclude>**/CantonTransferSyncService.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Keep Docker API version compatible for tests. Testcontainers' docker-java
        client reads the JVM system property "api.version".
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JDK 25 still permits Mockito's inline mock maker to self-attach, but future
               releases will reject dynamic agent loading.  Load it explicitly and retain
               JaCoCo's lifecycle-provided argLine via late property evaluation. -->
          <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
          <systemPropertyVariables>
            <api.version>${docker.api.test.version}</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
          <systemPropertyVariables>
            <api.version>${docker.api.test.version}</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- ── JaCoCo coverage ──────────────────────────────────────────────── -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- Exclude pure data carriers and infrastructure wiring that cannot
                   be meaningfully unit-tested without live external services.
                   Roadmap: line 0.36 (current floor) → 0.45 (after screening/KYC/audit ITs) → 0.60 (full).
                   The whole-bundle floor is a regression guard; the compliance-critical packages
                   below carry their own, higher floors so the code that matters most cannot erode. -->
              <excludes>
                <!-- Domain event records — pure data carriers with generated equals/hashCode -->
                <exclude>**/events/*Event.class</exclude>
                <!-- No-op stubs for optional integrations (Canton disabled by default) -->
                <exclude>**/*DisabledStub.class</exclude>
                <!-- Demo/seed data — only relevant to dev environment startup -->
                <exclude>**/bootstrap/DemoDataSeeder.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.36</minimum>
                    </limit>
                    <!-- Branch coverage is a distinct dimension: the compliance/financial
                         services are branch-heavy and line coverage alone hides untested paths. -->
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.23</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <!-- Regression floors for the compliance-critical packages that are already well
               covered (§19 register statements, customer/DSAR lifecycle). These lock in the
               current coverage so future changes to legally-sensitive logic cannot erode it. -->
          <execution>
            <id>check-compliance-critical</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>**/registerstatement/internal/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.42</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>check-customer-dsar</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>**/customer/internal/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.60</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.40</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <!-- Targeted floors for the previously near-untested financial packages (trading,
               registertransfer, blockchain.api — measured at ~14%/2%, ~7%/0%, ~17%/2% line/branch
               respectively before this round). Set just below what unit tests now cover, so the
               gate ratchets forward without going red on incidental fluctuation. -->
          <execution>
            <id>check-trading</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>**/trading/internal/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.25</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>check-registertransfer</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>**/registertransfer/internal/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>check-blockchain-api</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>**/blockchain/api/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.35</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.20</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>contracts</id>
      <!-- activate with -Pcontracts to run Foundry smart-contract tests -->
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>forge-test</id>
                <phase>integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>forge</executable>
                  <arguments>
                    <argument>test</argument>
                    <argument>-vvv</argument>
                  </arguments>
                  <workingDirectory>${project.basedir}/../contracts</workingDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Canton / DAML profile — requires JFrog credentials in ~/.m2/settings.xml:
        <server><id>digitalasset-releases</id><username>…</username><password>…</password></server>
      Activate with: mvn verify -Pcanton
    -->
    <profile>
      <id>canton</id>
      <dependencies>
        <dependency>
          <groupId>com.daml</groupId>
          <artifactId>bindings-java</artifactId>
          <version>${daml-bindings.version}</version>
        </dependency>
        <dependency>
          <groupId>io.grpc</groupId>
          <artifactId>grpc-netty-shaded</artifactId>
          <version>${grpc.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <!-- Override: include all Canton sources; DAML libs are on the classpath. -->
            <configuration combine.self="override">
              <annotationProcessorPaths>
                <path>
                  <groupId>org.mapstruct</groupId>
                  <artifactId>mapstruct-processor</artifactId>
                  <version>${mapstruct.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
