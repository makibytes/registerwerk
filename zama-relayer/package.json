{
  "name": "registerwerk-zama-relayer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "Registerwerk's own sidecar wrapping @zama-fhe/relayer-sdk — the encrypt/decrypt lifecycle piece Zama ships no Java client for. Not an external dependency: this is Registerwerk's code, built and shipped in this monorepo.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json",
    "wrap-operator-key": "node --loader ts-node/esm scripts/wrap-operator-key.ts"
  },
  "dependencies": {
    "@zama-fhe/relayer-sdk": "^0.4.4",
    "express": "^5.2.1",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
