{
  "name": "registerwerk-zama-relayer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "description": "Registerwerk's own sidecar wrapping @zama-fhe/relayer-sdk \u2014 the encrypt/decrypt lifecycle piece Zama ships no Java client for. Not an external dependency: this is Registerwerk's code, built and shipped in this monorepo.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json",
    "wrap-operator-key": "node --loader ts-node/esm scripts/wrap-operator-key.ts"
  },
  "dependencies": {
    "@zama-fhe/relayer-sdk": "^0.4.5",
    "express": "^5.3.0",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
