{
  "name": "registerwerk-zama-relayer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "Registerwerk's own sidecar wrapping @zama-fhe/relayer-sdk — the encrypt/decrypt lifecycle piece Zama ships no Java client for. Not an external dependency: this is Registerwerk's code, built and shipped in this monorepo.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@zama-fhe/relayer-sdk": "^0.4.4",
    "express": "^4.21.2",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  }
}
