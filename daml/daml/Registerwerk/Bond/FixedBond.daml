-- | Fixed-rate eWpG bond instrument.
--
-- This template tracks the on-ledger lifecycle status of a fixed-rate bond
-- (assetId link, registryAdmin party, regulator observer, coupon terms). It does
-- **not** move cash: the actual coupon/redemption/call payment leg is orchestrated
-- by the Registerwerk backend against the Canton Token Standard (CIP-0056), which
-- is a runtime-only dependency of this participant (see daml.yaml) — not composed
-- into these choices. Exercising a lifecycle choice here is the on-ledger record
-- of registry authorization for that payment, kept separately auditable from the
-- backend's own `corporate_action` / `audit_event` tables.
--
-- Lifecycle:
--   1. Registry creates a FixedRateBond instrument via Create choice.
--   2. On each pay date, the backend computes the coupon and the registry
--      exercises PayCoupon to authorize/record its settlement.
--   3. At maturity, registry exercises Redeem.
--   4. If callable, registry exercises EarlyCall on a date/price from callSchedule.
module Registerwerk.Bond.FixedBond where

import Registerwerk.Bond.Types

-- | A fixed-rate bond instrument registered under eWpG.
template FixedRateBond with
    assetId          : AssetId              -- ^ Registerwerk off-chain asset UUID
    registryAdmin    : Party               -- ^ Registry operator (registry wallet party)
    issuer           : Party               -- ^ Bond issuer
    regulatorObserver : Party              -- ^ BaFin or regulator (observer, receives all events)
    terms            : EwpgBondTerms
    couponRate       : Decimal             -- ^ Annual coupon rate (e.g. 0.05 for 5%)
    status           : Text                -- ^ "ACTIVE" | "MATURED" | "CALLED" | "REDEEMED"
  where
    signatory registryAdmin, issuer
    observer regulatorObserver

    ensure terms.assetId == assetId

    -- | Record a coupon payment settlement. Emits an event for the off-chain indexer.
    choice PayCoupon : ContractId FixedRateBond with
          paymentDate   : Date
          amountPerUnit : Decimal
          txRef         : Text
        controller registryAdmin
      do
        assertMsg "Bond is not ACTIVE — coupon cannot be paid" (status == "ACTIVE")
        assertMsg "Coupon amount must be positive" (amountPerUnit > 0.0)
        assertMsg "Coupon payment date cannot be after maturity" (paymentDate <= terms.maturityDate)
        create this with status = status

    -- | Redeem at maturity. Terminal choice — archives the instrument.
    choice Redeem : ()
        with redemptionDate : Date
        controller registryAdmin
      do
        assertMsg "Bond is not ACTIVE — cannot redeem" (status == "ACTIVE")
        assertMsg "Redemption date must be on or after maturity" (redemptionDate >= terms.maturityDate)
        return ()

    -- | Early call at a scheduled call date. Terminal choice.
    choice EarlyCall : ()
        with callDate : Date; callPrice : Decimal
        controller registryAdmin
      do
        assertMsg "Bond is not ACTIVE — cannot call" (status == "ACTIVE")
        assertMsg "Bond terms do not permit early call" terms.callable
        assertMsg "callDate/callPrice do not match an entry in the call schedule"
          (any (\c -> c.callDate == callDate && c.callPrice == callPrice) terms.callSchedule)
        return ()

    -- | Regulatory freeze (AWG §17 / GwG §40) — suspends the instrument.
    choice SuspendInstrument : ContractId FixedRateBond
        controller registryAdmin
      do
        create this with status = "SUSPENDED"

    -- | Lift suspension.
    choice ResumeInstrument : ContractId FixedRateBond
        controller registryAdmin
      do
        create this with status = "ACTIVE"
